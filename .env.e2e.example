# E2E environment template — copy to .env.e2e and fill in.
# .env.e2e points the dev server at the DEDICATED TEST Supabase project
# (thesims-test), never production. Loaded by `vite --mode e2e`, which the
# Playwright webServer command uses. In CI these come from repository secrets.
VITE_SUPABASE_URL=https://<test-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<test-project-anon-key>

# E2E test users (created in the test project's Auth dashboard)
E2E_ADMIN_EMAIL=admin@test.sims
E2E_ADMIN_PASSWORD=<password>
E2E_USER_EMAIL=user@test.sims
E2E_USER_PASSWORD=<password>
